# AI-OS Configuration Example
AIOS_LOG_LEVEL=INFO
DEFAULT_PROVIDER=mock
MODEL_NAME=gemini-1.5-flash

# Security & Control Plane
# Token required for Web Management API (POST /api/hitl/resolve, POST /api/processes/spawn, and WebSocket /ws/stream)
AIOS_ADMIN_TOKEN=
# Comma-separated allowed CORS origins (default: localhost 8000/3000)
AIOS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# API Keys (Optional - only needed if not using mock/offline)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Resource Governors
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_MAX_STEPS=15
DEFAULT_TIMEOUT_SECONDS=60.0
DEFAULT_WORKERS=4

# Memory Vectorization & Embeddings (hash, openai, gemini)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small

# Sandbox Isolation Backend (local, docker)
SANDBOX_BACKEND=local
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# HTTP Client & Connection Pooling
HTTP_POOL_MAX_KEEPALIVE=20
HTTP_POOL_MAX_CONNECTIONS=100
HTTP_TIMEOUT_SECONDS=45.0

# Telemetry & Audit Log Retention (days)
TRACE_RETENTION_DAYS=14
